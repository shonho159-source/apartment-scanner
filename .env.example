# העתק ל-.env ומלא. הקובץ .env נמצא ב-.gitignore — לא לקומיט סודות.

# Apify (console.apify.com → Settings → API tokens)
APIFY_TOKEN=

# OpenAI (platform.openai.com → API Keys) — סיווג עם gpt-5.4-mini
OPENAI_API_KEY=

# Green API (green-api.com → יצירת instance + סריקת QR)
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=

# מספר היעד בוואטסאפ בפורמט בינלאומי בלי +, עם סיומת @c.us
# לדוגמה: 972501234567@c.us
WHATSAPP_CHAT_ID=

# DRY_RUN=1 → מדפיס את ההודעה במקום לשלוח
DRY_RUN=
